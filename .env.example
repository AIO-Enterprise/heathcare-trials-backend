# Copy to .env and fill in real values. Never commit .env.
# Rule: fill the side you want, leave the other side empty.
# Code auto-detects family by model name (gpt-* = OpenAI path,
# claude* = Anthropic path). Strict per-slot fallback: AZURE_{SLOT}_*
# set → Azure, else AWS_{SLOT}_MODEL. No cross-slot inheritance.

# Application Secrets
SECRET_KEY=<64-hex-chars-from-secrets.token_hex-32>
DEBUG=false
APP_ENV=dev
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
BACKEND_HOSTING_URL=

# Auth cookies: dev default (lax) needs same-origin API calls (Vite proxy).
# Split-origin prod (frontend + backend on different hosts) needs:
# COOKIE_SAMESITE=none (forces Secure, requires HTTPS).
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=

# Database
DATABASE_URL=sqlite+aiosqlite:///./marketing_platform.db

# Foundry Curator
AZURE_CURATOR_API_URL=
AZURE_CURATOR_API_KEY=
AZURE_CURATOR_API_VERSION=
AZURE_CURATOR_MODEL=

# Foundry Generic
AZURE_GENERIC_API_URL=
AZURE_GENERIC_API_KEY=
AZURE_GENERIC_API_VERSION=
AZURE_GENERIC_MODEL=

# Foundry Chat
AZURE_CHAT_API_URL=
AZURE_CHAT_API_KEY=
AZURE_CHAT_API_VERSION=
AZURE_CHAT_MODEL=

# Foundry Image Gen
AZURE_IMAGE_GEN_API_URL=
AZURE_IMAGE_GEN_API_KEY=
AZURE_IMAGE_GEN_VERSION=
AZURE_IMAGE_GEN_MODEL=

# AWS Login Credentials
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bedrock Curator
AWS_CURATOR_MODEL=

# Bedrock Generic
AWS_GENERIC_MODEL=

# Bedrock Chat
AWS_CHAT_MODEL=

# Bedrock Image Gen (reserved — Bedrock serves no images)
AWS_IMAGE_GEN_MODEL=

# Google Ads Credentials
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_OAUTH_REDIRECT_URI=/api/platform-connections/google/callback

# Meta Ads Credentials
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=/api/platform-connections/meta/callback

# ElevenLabs Credentials
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
