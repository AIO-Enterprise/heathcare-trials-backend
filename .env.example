# Copy to .env and fill in real values. Never commit .env.
SECRET_KEY=<64-hex-chars-from-secrets.token_hex-32>
DEBUG=false
APP_ENV=dev
DATABASE_URL=sqlite+aiosqlite:///./marketing_platform.db
BACKEND_PUBLIC_URL=http://127.0.0.1:8000
APP_PUBLIC_URL=http://127.0.0.1:8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
USE_BEDROCK=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=http://localhost:8000/api/platform-connections/meta/callback
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_OAUTH_REDIRECT_URI=http://localhost:8000/api/platform-connections/google/callback
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
OPENAI_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Storage backend: local | s3 | azure (default local; stored paths identical).
STORAGE_BACKEND=local
STORAGE_BUCKET=
STORAGE_PREFIX=
AZURE_STORAGE_CONNECTION_STRING=
